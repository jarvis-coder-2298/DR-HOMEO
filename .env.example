# Run npm run setup to create these values in .env.local.
# Copy values to Vercel > Project > Settings > Environment Variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Connect a PRIVATE Vercel Blob store to set this on Vercel.
# Leave blank locally to use data/site.local.json.
BLOB_READ_WRITE_TOKEN=
