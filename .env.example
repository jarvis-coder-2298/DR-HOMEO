# Run npm run setup to create these values in .env.local.
# Copy values to Vercel > Project > Settings > Environment Variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Connect a PRIVATE Vercel Blob store and copy its credentials here.
# Keep both blank locally to use data/site.local.json.
# Store ID alone requires Vercel-provided OIDC authentication.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
